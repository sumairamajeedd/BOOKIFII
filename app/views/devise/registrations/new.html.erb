<div class="max-w-md mx-auto bg-white p-6 shadow rounded-lg">
  <h2 class="text-2xl font-bold mb-4">Sign Up</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    
    <div class="mb-4">
      <%= f.label :email, class: "block text-sm font-medium text-red-600" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", 
            class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:outline-none" %>
    </div>

    <!-- Password -->
    <div class="mb-4">
      <div class="flex justify-between items-center">
        <%= f.label :password, class:"block text-sm font-medium text-red-500" %>
        <% if @minimum_password_length %>
          <span class="text-xs text-gray-500">
            (<%= @minimum_password_length %> characters minimum)
          </span>
        <% end %>
      </div>
      <%= f.password_field :password, autocomplete: "new-password", 
            class:"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:outline-none" %>
    </div>

    <!-- Confirm Password -->
    <div class="mb-6">
      <%= f.label :password_confirmation, class:"block text-sm font-medium text-red-500" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",  
            class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:outline-none" %>
    </div>

    <!-- Submit -->
    <div class="mb-4">
      <%= f.submit "Sign up", class: "w-full bg-red-600 text-white py-2 rounded-lg hover:bg-red-700 transition" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
