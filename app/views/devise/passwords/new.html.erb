
<div class="max-w-md mx-auto bg-white p-6 shadow rounded-lg">
  <h2 class="text-2xl font-bold mb-4 text-center">Forgot your password?</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <div class="mb-4">
      <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:outline-none" %>
    </div>

    <div class="mb-6">
      <%= f.submit "Send me reset password instructions", 
            class: "w-75 bg-red-600 text-white py-3 rounded-lg hover:bg-red-700 transition" %>
    </div>
  <% end %>

   <div class="text-center text-sm text-gray-600 space-x-4">
    <%= render "devise/shared/links" %>
  </div>
</div>
