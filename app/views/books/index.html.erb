<div class="max-w-7xl mx-auto px-6 py-10">
  <!-- Page Heading -->
  <h2 class="text-3xl font-bold mb-8">Browse Books</h2>

  <!-- Filters -->
  <div class="bg-white shadow rounded-lg p-6 mb-8">
    <%= search_form_for @q, url: books_path, method: :get, class: "flex flex-wrap gap-4 items-end" do |f| %>
      <div>
        <%= f.label :title_cont, "Title", class: "block text-sm font-medium text-gray-700" %>
        <%= f.search_field :title_cont, class: "mt-1 block w-48 rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
      </div>

      <div>
        <%= f.label :author_cont, "Author", class: "block text-sm font-medium text-gray-700" %>
        <%= f.search_field :author_cont, class: "mt-1 block w-48 rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
      </div>

      <div>
        <%= f.label :category_eq, "Category", class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :category_eq, Book.distinct.pluck(:category).compact, { include_blank: "All" }, class: "mt-1 block w-48 rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
      </div>

      <div>
        <%= f.submit "Filter", class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white font-semibold rounded-lg shadow hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>

  <!-- Search Results -->
  <% if @search_performed && @books.any? %>
    <h3 class="text-2xl font-semibold mb-4 text-gray-800">Search Results</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 mb-10">
      <%= render partial: "books/book_card", collection: @books, as: :book %>
    </div>
  <% end %>

  <!-- Recommended Books (Word-based) -->
  <% if @word_recommended.present? %>
    <h3 class="text-2xl font-semibold mb-4 text-green-700">Recommended Books (Word-based)</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 mb-10">
      <%= render partial: "books/book_card", collection: @word_recommended, as: :book %>
    </div>
  <% end %>

  <!-- Recommended Books (Category-based) -->
  <% if @category_recommended.present? %>
    <h3 class="text-2xl font-semibold mb-4 text-purple-700">Recommended Books (Category-based)</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 mb-10">
      <%= render partial: "books/book_card", collection: @category_recommended, as: :book %>
    </div>
  <% end %>

  <!-- All Books Section -->
  <h3 class="text-2xl font-semibold mb-4 text-gray-800">All Books</h3>
  <% if @books.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <%= render partial: "books/book_card", collection: @books, as: :book %>
    </div>
  <% else %>
    <p class="text-gray-600">No books found.</p>
  <% end %>
</div>
