<div class="bg-white shadow rounded-lg p-4 hover:shadow-lg transition">
  <% if book.thumbnail.present? %>
    <%= image_tag book.thumbnail, alt: book.title, class: "w-full h-48 object-cover rounded-md" %>
  <% else %>
    <div class="w-full h-48 bg-gray-200 rounded-md flex items-center justify-center text-gray-500">
      No Image
    </div>
  <% end %>

  <h3 class="mt-3 font-semibold text-lg truncate">
    <%= link_to book.title, book_path(book), class: "text-blue-600 hover:underline" %>
  </h3>

  <p class="text-sm text-gray-600"><%= book.author.presence || "Unknown Author" %></p>

  <% if book.category.present? %>
    <p class="text-xs mt-1">
      <span class="bg-gray-100 px-2 py-1 rounded"><%= book.category %></span>
    </p>
  <% end %>
</div>
