<div class="max-w-5xl mx-auto px-6 py-10">
  <!-- Book Card -->
  <div class="bg-white shadow-lg rounded-2xl p-8">
    <!-- Title -->
    <h1 class="text-3xl font-bold text-gray-900 mb-4">
      <%= @book.title %>
    </h1>

    <!-- Metadata -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 text-sm text-gray-700 mb-6">
      <p><span class="font-semibold">Author:</span> <%= @book.author %></p>
      <p><span class="font-semibold">Category:</span> <%= @book.category %></p>
      <p><span class="font-semibold">Publisher:</span> <%= @book.publisher %></p>
      <p><span class="font-semibold">Published Date:</span> <%= @book.published_date %></p>
      <p><span class="font-semibold">Language:</span> <%= @book.language %></p>
      <p><span class="font-semibold">Average Rating:</span> <%= @book.average_rating || "N/A" %></p>
      <p><span class="font-semibold">Ratings Count:</span> <%= @book.ratings_count || "N/A" %></p>
      <p><span class="font-semibold">Saleability:</span> <%= @book.saleability %></p>
      <p><span class="font-semibold">Ebook:</span> <%= @book.is_ebook ? "Yes" : "No" %></p>
    </div>

    <!-- Description -->
    <div class="text-gray-800 leading-relaxed mb-6">
      <%= @book.description %>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-4">
     <%= button_to "Mark as Read",
      book_user_books_path(@book, status: "completed"),
      method: :post,
      class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-5 rounded-xl shadow-md transition" %>

      <%= link_to "Back to Books",
          books_path,
          class: "text-blue-600 hover:underline" %>
    </div>
  </div>
</div>
