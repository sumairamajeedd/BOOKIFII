<section class="py-16 bg-white">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="text-3xl font-bold mb-6">Get in Touch</h2>
    <p class="text-gray-600 mb-12">
      Have a question, feedback, or partnership idea? We’d love to hear from you!
    </p>

    <%= form_with url: contact_path, local: true, class: "space-y-6" do |f| %>
      <div>
        <%= f.label :name, class: "block text-left font-semibold" %>
        <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg p-3" %>
      </div>
      <div>
        <%= f.label :email, class: "block text-left font-semibold" %>
        <%= f.email_field :email, class: "w-full border border-gray-300 rounded-lg p-3" %>
      </div>
      <div>
        <%= f.label :message, class: "block text-left font-semibold" %>
        <%= f.text_area :message, rows: 5, class: "w-full border border-gray-300 rounded-lg p-3" %>
      </div>
      <%= f.submit "Send Message", class: "bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700" %>
    <% end %>
  </div>
</section>
